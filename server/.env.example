# ─────────────────────────────────────────────────────────────────────────────
# SAHARA Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (used for CORS + email links) ────────────────────────────────
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (set this in Render dashboard to your Vercel URL):
# CLIENT_URL=https://your-app.vercel.app

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sahara?retryWrites=true&w=majority

# ── JWT Secrets (use 64+ random characters each) ─────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_chars
JWT_REFRESH_SECRET=replace_with_different_64_random_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OpenRouter AI (server-side only — NEVER put in client/.env) ───────────────
# Get free API key from: https://openrouter.ai/keys
# Free models available — no credit card needed
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# Other free model options:
# OPENROUTER_MODEL=anthropic/claude-3-haiku
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ── Resend Email Service ──────────────────────────────────────────────────────
# Get free API key (3000 emails/month) from: https://resend.com
# Free tier sends from: onboarding@resend.dev
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=SAHARA <onboarding@resend.dev>
# With custom domain (after verifying on Resend dashboard):
# EMAIL_FROM=SAHARA <noreply@yourdomain.com>

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
