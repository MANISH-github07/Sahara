PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/sahara

JWT_SECRET=replace_with_64_random_chars_abcdef1234567890abcdef1234567890abcdef1234567890
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_random_chars_abcdef1234567890abcdef1234567890
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=SAHARA <noreply@sahara.care>

# Gemini — server-side ONLY. Never put this key in client/.env
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
